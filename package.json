{
	"name": "wbh",
	"version": "265.0.1",
	"description": "🔨 Restrict access to your website from web browsers without specific features.",
	"keywords": [
		"browsers",
		"caniuse",
		"support",
		"target",
		"wbh",
		"webdev"
	],
	"homepage": "https://github.com/mdrv/wbh",
	"bugs": {
		"url": "https://github.com/mdrv/wbh/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mdrv/wbh.git"
	},
	"license": "GPL-3.0",
	"author": "Umar Alfarouk <medrivia@gmail.com> (https://alfarouk.id)",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./data": "./src/data.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"b": "tsdown",
		"f": "dprint fmt",
		"fc": "dprint check",
		"g": "bun ./scripts/gen.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"default": "./dist/index.js",
				"types": "./dist/index.d.ts"
			},
			"./data": {
				"default": "./dist/data.js",
				"types": "./dist/data.d.ts"
			}
		}
	},
	"dependencies": {
		"es-toolkit": "^1.46.1"
	},
	"devDependencies": {
		"@mdn/browser-compat-data": "^8.0.0",
		"@types/bun": "^1.3.14",
		"caniuse-db": "^1.0.30001793",
		"tsdown": "^0.22.0"
	}
}
