#!/bin/bash
# Validates that every commit message starts with v{YY}{M}.{MINOR}.{COMMIT} - type: description
# AND that the version EXACTLY matches package.json current version.
#
# Input: $1 = path to commit message file (.git/COMMIT_EDITMSG)

INPUT_FILE="$1"
FIRST_LINE=$(head -n1 "$INPUT_FILE")

# Match: vdigits.digits.digits - type: description
PATTERN="^v[0-9]+\.[0-9]+\.[0-9]+ - (feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert): .+"

if [[ ! "$FIRST_LINE" =~ $PATTERN ]]; then
	echo ""
	echo "❌ Invalid commit message format."
	echo ""
	echo "Expected: v{YY}{M}.{MINOR}.{COMMIT} - {type}: {description}"
	echo ""
	echo "Examples:"
	echo "  v265.0.2   - feat: add CSS anchor positioning detection"
	echo "  v265.0.3   - fix: resolve safari version inference"
	echo "  v266.0.0   - chore: new YYM cycle (June 2026)"
	echo ""
	echo "Current version (from package.json):"
	CURRENT=$(node -e "console.log(require('./package.json').version)")
	echo "  Next commit should be: v${CURRENT} - type: description"
	echo ""
	exit 1
fi

# Extract version from commit message
VERSION=$(echo "$FIRST_LINE" | grep -oE "^v[0-9]+\.[0-9]+\.[0-9]+")
PKG_VERSION=$(node -e "console.log(require('./package.json').version)")

# STRICT: commit message version MUST equal package.json version
# (pre-commit will bump it after this passes)
if [ "$VERSION" != "v$PKG_VERSION" ]; then
	echo ""
	echo "❌ Version mismatch."
	echo ""
	echo "   Commit message:  ${VERSION}"
	echo "   package.json:    v${PKG_VERSION}"
	echo ""
	echo "   Your commit message version must match package.json exactly."
	echo "   The pre-commit hook will auto-bump after this check passes."
	echo ""
	if [ "$PKG_VERSION" > "$(echo "$VERSION" | sed 's/^v//')" ] 2>/dev/null; then
		echo "   💡 Tip: package.json is ahead — you may be amending."
		echo "      Use the current package.json version in your amend message:"
		echo "      v${PKG_VERSION} - type: description"
	fi
	echo ""
	exit 1
fi

echo "✅ Version matched: ${VERSION}"
exit 0
